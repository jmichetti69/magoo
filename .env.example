ANTHROPIC_API_KEY=your_api_key_here

# Optional: override the ffmpeg binary path. By default, the bundled ffmpeg-static
# binary is used, which works everywhere (local dev and Vercel). Only set this
# if you want to use a custom ffmpeg binary (e.g., for testing a locally-built version).
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Set to "true" to skip the Claude API call and use canned visual/audio
# descriptions instead — lets you test the ffmpeg render + audio + compose
# pipeline before an ANTHROPIC_API_KEY is available.
MAGOO_MOCK_MODE=false

# Used to generate the starting still image from a text prompt (skipped if
# the user uploads their own photo instead). Billed separately from any
# ChatGPT Plus subscription — a plain OpenAI API account/key is all you need.
OPENAI_API_KEY=your_openai_api_key_here

# Kling AI image-to-video. Requires a separate API account + prepaid credits
# from kling.ai/dev — a consumer Kling subscription does NOT grant API
# access. Kling issues a single API key (used as a Bearer token), not an
# Access/Secret key pair.
KLING_API_KEY=your_kling_api_key_here
# KLING_API_BASE=https://api-singapore.klingai.com

# YouTube auto-upload. Requires a Google Cloud project with the YouTube Data
# API enabled, an OAuth client, and a one-time authorization against the
# target channel to obtain a refresh token. Leave unset to skip upload —
# the pipeline still completes with a local download link.
YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_oauth_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_oauth_refresh_token_here

# How many hours the final looped video should run.
LOOP_TARGET_HOURS=8
